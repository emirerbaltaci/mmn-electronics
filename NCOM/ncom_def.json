{
    "protocol": "NCOM",
    "name": "Nautronics Communication Protocol",
    "version": "0.1",
    "max_payload_size_bytes": 255,
    "endianness": "little",
    "header_size_bytes": 5,
    "footer_size_bytes": 2,
    "sync_byte_count": 2,
    "sync_byte_1": 165,
    "sync_byte_2": 90,
    "config_desc": "0xA5 (165) and 0x5A (90) are used as default sync bytes. Also, the protocol is little-endian by default. Maximum payload size is 255 bytes, overhead excluded.",
    "directions": {
        "MCU_TO_HOST": 0,
        "HOST_TO_MCU": 1,
        "BIDIRECTIONAL": 2
    },
    "msg_sections": [
        {
            "name": "core",
            "id_range": [
                0,
                9
            ],
            "desc": "Vehicle status, mode and control"
        },
        {
            "name": "nav",
            "id_range": [
                10,
                19
            ],
            "desc": "Navigation information"
        },
        {
            "name": "sensor",
            "id_range": [
                20,
                29
            ],
            "desc": "Sensor data"
        },
        {
            "name": "actuator",
            "id_range": [
                30,
                39
            ],
            "desc": "Actuator data"
        },
        {
            "name": "config",
            "id_range": [
                40,
                49
            ],
            "desc": "MCU configuration management"
        },
        {
            "name": "acoustics",
            "id_range": [
                70,
                99
            ],
            "desc": "Special messages for acoustic communication"
        },
        {
            "name": "mission",
            "id_range": [
                100,
                199
            ],
            "desc": "Mission data"
        },
        {
            "name": "error",
            "id_range": [
                200,
                255
            ],
            "desc": "Error messages"
        }
    ],
    "includes": {
        "core": {
            "enabled": true,
            "path": "msg/core.json"
        },
        "nav": {
            "enabled": true,
            "path": "msg/nav.json"
        },
        "sensor": {
            "enabled": true,
            "path": "msg/sensor.json"
        },
        "actuator": {
            "enabled": true,
            "path": "msg/actuator.json"
        },
        "config": {
            "enabled": true,
            "path": "msg/config.json"
        },
        "acoustics": {
            "enabled": true,
            "path": "msg/acoustics.json"
        },
        "mission": {
            "enabled": true,
            "path": "msg/mission.json"
        },
        "error": {
            "enabled": true,
            "path": "msg/error.json"
        }
    }
}