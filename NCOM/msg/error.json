{
    "section": "error",
    "id_range": [
        200,
        255
    ],
    "messages": [
        {
            "id": 200,
            "name": "INIT_ERROR",
            "direction": "MCU_TO_HOST",
            "desc": "Sent when an error occurs during initialization",
            "payload": [
                {
                    "name": "error_code",
                    "type": "uint8",
                    "desc": "Error code",
                    "enum": {
                        "IMU_INIT_ERR": 0,
                        "MAG_INIT_ERR": 1,
                        "BAR30_INIT_ERR": 2
                    }
                }
            ]
        },
		{
			"id": 255,
			"name": "DYING_GASP",
			"direction": "MCU_TO_HOST",
			"desc": "Sent when a critical task does not respond. The MCU then undergoes IWDG reset",
			"payload": [
				{
					"name": "dead_tasks",
					"type": "uint8",
					"desc": "Dead tasks list, sent as a bitmask",
					"flags_type": "bitmask",
					"flags": {
						"EKF_TASK_DEAD": 0,
						"CONTROL_TASK_DEAD": 1,
						"NCOM_TASK_DEAD": 2
					}
				}
				]
		}
    ]
}