			"payload": [
				{
					"name": "flag_uint",
					"type": "uint32",
					"desc": "Configurable flags."
				}
			]
		},
		{
			"id": 51,
			"name": "ASSIGN_FLAG_BIT",
			"direction": "HOST_TO_MCU",
			"desc": "Assign the meaning of the bit",
			"payload": [
				{
					"name": "bit_position",
