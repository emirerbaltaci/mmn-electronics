{

	"protocol": "NCOM",
	"name": "Nautronics Communication Protocol",
	"version": "0.1",
	
	"endianness": "little",
	"sync_byte": 165,
	"config_desc": "165 (0xA5) is used as default sync byte. Also, the protocol is little-endian by default.",
	
	"directions": {
		"MCU_TO_HOST": 0,
		"HOST_TO_MCU": 1,
		"BIDIRECTIONAL": 2
	},
	
	"msg_sections": [
		{ "name": "core", "id_range": [0, 9], "desc": "Vehicle status, mode and control"},
		{ "name": "nav", "id_range": [10, 19], "desc": "Navigation information"},
		{ "name": "sensor", "id_range": [20, 29], "desc": "Sensor data"},
		{ "name": "actuator", "id_range": [30, 39], "desc": "Actuator data"},
		{ "name": "mission", "id_range": [100, 199], "desc": "Mission data"},
		{ "name": "error", "id_range": [200, 255], "desc": "Error messages"}
	],

	"includes": {
		
		"core": {
			"enabled": true,
			"path": "msg/core.json"
		},
		
		"nav": {
			"enabled": true,
			"path": "msg/nav.json"
		},
		
		"sensor": {
			"enabled": true,
			"path": "msg/sensor.json"
		},
		
		"actuator": {
			"enabled": true,
			"path": "msg/actuator.json"
		},
		
		"mission": {
			"enabled": true,
			"path": "msg/mission.json"
		},
		
		"error": {
			"enabled": true,
			"path": "msg/error.json"
		}
		
	}

}